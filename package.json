{
  "name": "atlasdasoberania",
  "type": "module",
  "version": "1.0.0",
  "description": "Painel interativo e didático sobre a criticidade e vulnerabilidade da cadeia industrial brasileira",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,astro}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,astro}\" --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,astro,json,css,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,astro,json,css,md}\"",
    "validate": "npm run lint && npm run typecheck && npm run format",
    "clean": "rm -rf dist .astro node_modules/.cache",
    "reinstall": "rm -rf node_modules package-lock.json && npm install"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "astro": "^7.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
}
