---
import Layout from '@/layouts/Layout.astro';
import { atlasData } from '@/lib/data';
import { DynamicIcon } from '@/components/DynamicIcon';
import { Badge } from '@/components/ui/badge';
import { InteractiveExplorer } from '@/components/InteractiveExplorer';
import { ArrowLeft, Flame } from 'lucide-react';

export function getStaticPaths() {
  return atlasData.pillars.map((pillar) => ({
    params: { id: pillar.id },
    props: { pillar },
  }));
}

const { pillar } = Astro.props;
const baseUrl = '/atlasdasoberania';
---

<Layout
  title={`${pillar.name} | Atlas da Soberania`}
  description={pillar.description}
>
  <div class="container mx-auto space-y-10 px-4 py-10 sm:px-6">
    <!-- Breadcrumb & Back -->
    <div class="flex items-center gap-2 text-sm text-muted-foreground">
      <a
        href={`${baseUrl}/pilares`}
        class="flex items-center gap-1 hover:text-foreground"
      >
        <ArrowLeft className="size-4" />
        <span>Voltar aos Pilares</span>
      </a>
      <span>/</span>
      <span class="font-semibold text-foreground">{pillar.name}</span>
    </div>

    <!-- Pillar Hero Banner -->
    <div class="space-y-6 rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
      <div class="flex flex-col justify-between gap-4 border-b border-border/60 pb-6 sm:flex-row sm:items-center">
        <div class="flex items-start gap-4 sm:items-center">
          <div class="flex size-14 shrink-0 items-center justify-center rounded-2xl border border-primary/20 bg-primary/10 text-primary">
            <DynamicIcon name={pillar.icon} className="size-7" />
          </div>
          <div>
            <div class="flex items-center gap-2.5">
              <span class="font-mono text-xs font-bold uppercase text-muted-foreground sm:text-sm">
                Pilar #{pillar.order}
              </span>
              <Badge
                variant={
                  pillar.overallScore >= 80
                    ? 'critical'
                    : pillar.overallScore >= 60
                      ? 'high'
                      : 'moderate'
                }
                className="font-mono text-xs font-semibold sm:text-sm"
              >
                ICVS {pillar.overallScore.toFixed(1)} / 100
              </Badge>
            </div>
            <h1 class="mt-0.5 text-2xl font-black tracking-tight text-foreground sm:text-4xl">
              {pillar.name}
            </h1>
            <p class="mt-1 text-base font-semibold text-primary">
              {pillar.tagline}
            </p>
          </div>
        </div>
      </div>

      <!-- Overview and Logistics Warning -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="space-y-4 lg:col-span-2">
          <p class="text-base leading-relaxed text-foreground/90 sm:text-lg">
            {pillar.description}
          </p>

          <div class="space-y-2 pt-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground sm:text-sm">
              Pontos Críticos e Vulnerabilidades:
            </h4>
            <ul class="space-y-1.5 text-sm text-foreground/90">
              {pillar.highlights.map((h) => (
                <li class="flex items-start gap-2">
                  <span class="font-bold text-red-500">•</span>
                  <span class="font-medium">{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="space-y-3 rounded-xl border border-amber-500/30 bg-amber-500/10 p-5">
          <div class="flex items-center gap-2 text-sm font-bold text-amber-700 dark:text-amber-400">
            <Flame className="size-4" />
            <span>Nó do Diesel & Transporte Rodoviário</span>
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground">
            {pillar.logisticsHighlight}
          </p>
          <div class="border-t border-amber-500/20 pt-2 text-xs text-amber-800 dark:text-amber-300 sm:text-sm">
            Saiba mais na página dedicada sobre o{' '}
            <a href={`${baseUrl}/logistica`} class="font-bold underline">
              Nó do Diesel
            </a>
            .
          </div>
        </div>
      </div>
    </div>

    <!-- Production Chains Section -->
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
            Cadeias Produtivas de {pillar.name}
          </h2>
          <p class="text-sm text-muted-foreground sm:text-base">
            Explore as etapas estruturadas da matéria-prima até a distribuição
            final
          </p>
        </div>
      </div>

      <div class="space-y-8">
        {pillar.chains.map((chain) => (
          <div class="space-y-4 rounded-2xl border border-border bg-card p-6">
            <div class="border-b border-border/60 pb-3">
              <h3 class="text-xl font-bold text-foreground">{chain.name}</h3>
              <p class="text-sm text-muted-foreground sm:text-base">
                {chain.description}
              </p>
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              {chain.stages.map((stage) => (
                <div class="space-y-3 rounded-xl border border-border bg-muted/20 p-4 transition-colors hover:border-primary/40">
                  <div class="flex items-center justify-between gap-2">
                    <Badge variant="outline" className="text-xs">
                      {stage.category}
                    </Badge>
                    <Badge
                      variant={
                        stage.scores.finalScore >= 80
                          ? 'critical'
                          : stage.scores.finalScore >= 60
                            ? 'high'
                            : 'moderate'
                      }
                      className="font-mono text-xs font-semibold sm:text-sm"
                    >
                      ICVS {stage.scores.finalScore.toFixed(1)}
                    </Badge>
                  </div>

                  <div>
                    <h4 class="text-base font-bold text-foreground">
                      {stage.name}
                    </h4>
                    <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
                      {stage.summary}
                    </p>
                  </div>

                  <div class="grid grid-cols-3 gap-2 rounded-lg border border-border/50 bg-card p-2 text-center text-xs">
                    <div>
                      <div class="text-xs text-muted-foreground">Dep. Ext</div>
                      <div class="font-mono text-sm font-bold text-red-500 sm:text-base">
                        {stage.scores.extDependence}%
                      </div>
                    </div>
                    <div>
                      <div class="text-xs text-muted-foreground">Imp. Sist</div>
                      <div class="font-mono text-sm font-bold text-amber-500 sm:text-base">
                        {stage.scores.systemicImpact}
                      </div>
                    </div>
                    <div>
                      <div class="text-xs text-muted-foreground">Rodovia</div>
                      <div class="font-mono text-sm font-bold text-orange-500 sm:text-base">
                        {stage.logistics.roadShare}%
                      </div>
                    </div>
                  </div>

                  <div class="space-y-1 text-xs">
                    <span class="text-xs font-semibold text-muted-foreground sm:text-sm">
                      Origens de Importação:
                    </span>
                    <div class="flex flex-wrap gap-1.5">
                      {stage.importPartners.map((p) => (
                        <span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-card px-2 py-0.5 text-xs">
                          <span class="text-sm">{p.flag}</span>
                          <span class="font-medium">{p.country}</span>
                          <span class="font-mono font-bold text-muted-foreground">
                            {p.sharePercentage}%
                          </span>
                        </span>
                      ))}
                      {stage.importPartners.length === 0 && (
                        <span class="text-xs italic text-muted-foreground sm:text-sm">
                          Produção interna
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Interactive Search for this Pillar -->
    <div class="space-y-4 border-t border-border pt-6">
      <h3 class="text-xl font-bold text-foreground">
        Filtrar Etapas deste e de outros Pilares
      </h3>
      <InteractiveExplorer client:visible />
    </div>
  </div>
</Layout>
