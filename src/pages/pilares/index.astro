---
import Layout from '@/layouts/Layout.astro';
import { atlasData } from '@/lib/data';
import { DynamicIcon } from '@/components/DynamicIcon';
import { Badge } from '@/components/ui/badge';
import { ArrowRight, Flame, ChevronRight, Layers } from 'lucide-react';

const baseUrl = '/atlasdasoberania';
---

<Layout
  title="Os 8 Pilares da Soberania | Atlas da Soberania Industrial"
  description="Análise profunda das 8 cadeias produtivas essenciais do Brasil: Agricultura, Pecuária, Energia, Água, Combustível, Indústria Civil, Militar e Tecnologia."
>
  <div class="container mx-auto space-y-10 px-4 py-10 sm:px-6">
    <!-- Header -->
    <div class="max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-bold text-primary sm:text-sm">
        <Layers className="size-3.5" />
        <span>Estrutura Produtiva Nacional</span>
      </div>
      <h1 class="text-3xl font-black tracking-tight text-foreground sm:text-4xl">
        Os 8 Pilares da Soberania Industrial
      </h1>
      <p class="text-base leading-relaxed text-muted-foreground sm:text-lg">
        Cada um dos 8 pilares abaixo sustenta o funcionamento diário da
        sociedade, da alimentação básica às defesas de fronteira e
        telecomunicações. Explore os relatórios detalhados de cada setor.
      </p>
    </div>

    <!-- Pillars List -->
    <div class="space-y-6">
      {atlasData.pillars.map((pillar) => (
        <div class="space-y-6 rounded-2xl border border-border bg-card p-6 shadow-sm transition-all hover:border-primary/40 sm:p-8">
          <div class="flex flex-col justify-between gap-4 border-b border-border/60 pb-5 sm:flex-row sm:items-center">
            <div class="flex items-start gap-3.5 sm:items-center">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary">
                <DynamicIcon name={pillar.icon} className="size-6" />
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-2xl font-bold text-foreground sm:text-3xl">
                    {pillar.order}. {pillar.name}
                  </h2>
                  <Badge
                    variant={
                      pillar.overallScore >= 80
                        ? 'critical'
                        : pillar.overallScore >= 60
                          ? 'high'
                          : 'moderate'
                    }
                    className="font-mono text-xs font-semibold sm:text-sm"
                  >
                    ICVS {pillar.overallScore.toFixed(1)}
                  </Badge>
                </div>
                <p class="mt-0.5 text-sm font-semibold text-primary sm:text-base">
                  {pillar.tagline}
                </p>
              </div>
            </div>

            <a
              href={`${baseUrl}/pilares/${pillar.id}`}
              class="inline-flex h-10 items-center justify-center gap-1.5 self-start whitespace-nowrap rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 sm:self-auto"
            >
              <span>Ver Cadeias Detalhadas</span>
              <ChevronRight className="size-4" />
            </a>
          </div>

          <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            <div class="space-y-4 lg:col-span-2">
              <p class="text-base leading-relaxed text-foreground/90">
                {pillar.description}
              </p>

              <div class="space-y-2">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground sm:text-sm">
                  Pontos Críticos Identificados:
                </h4>
                <ul class="space-y-1.5 text-sm text-foreground/90">
                  {pillar.highlights.map((highlight) => (
                    <li class="flex items-start gap-2">
                      <span class="font-bold text-red-500">•</span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="flex flex-col justify-between rounded-xl border border-amber-500/30 bg-amber-500/10 p-4">
              <div>
                <div class="mb-1.5 flex items-center gap-1.5 text-sm font-bold text-amber-700 dark:text-amber-400">
                  <Flame className="size-4" />
                  <span>Vulnerabilidade ao Diesel & Rodovia</span>
                </div>
                <p class="text-sm leading-relaxed text-muted-foreground">
                  {pillar.logisticsHighlight}
                </p>
              </div>

              <div class="mt-4 flex items-center justify-between border-t border-amber-500/20 pt-3 text-sm font-medium text-amber-800 dark:text-amber-300">
                <span>{pillar.chains.length} cadeia(s) mapeadas</span>
                <a
                  href={`${baseUrl}/pilares/${pillar.id}`}
                  class="flex items-center gap-1 font-semibold hover:underline"
                >
                  Explorar pilar <ArrowRight className="size-3.5" />
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
